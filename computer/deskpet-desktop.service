[Unit]
Description=Xiaoxi private view-only work desktop
After=network-online.target
RequiresMountsFor=/mnt/nvme
ConditionPathIsMountPoint=/mnt/nvme

[Service]
Type=simple
User=deskpet-desktop
Group=deskpet-desktop
SupplementaryGroups=render video
WorkingDirectory=/mnt/nvme/deskpet-desktop
Environment=HOME=/mnt/nvme/deskpet-desktop
Environment=XDG_CACHE_HOME=/mnt/nvme/deskpet-desktop/cache
Environment=TMPDIR=/mnt/nvme/deskpet-desktop/tmp
ExecStart=/usr/bin/python3 /opt/deskpet-desktop/desktop_daemon.py
StandardOutput=append:/mnt/nvme/deskpet-desktop/desktop.log
StandardError=append:/mnt/nvme/deskpet-desktop/desktop.log
UMask=0077
PrivateTmp=yes
KillMode=control-group
TimeoutStopSec=12
MemoryMax=1200M
TasksMax=192
Restart=no
