# Copy outside the repository, chmod 600. Never put keys in CLI arguments.
# Choose your provider and actual enabled API model. See docs/MODELS.md.
# Providers: minimax, openai, anthropic, deepseek, qwen, doubao, gemini, ollama, custom.
LLM_PROVIDER=minimax
LLM_MODEL=
LLM_API_KEY=
# Optional overrides. API base includes any /v1 prefix, never /chat/completions.
# LLM_BASE_URL=https://api.minimaxi.com
# LLM_API_TYPE=minimax-messages

# ASR, TTS and search are independent. For a non-MiniMax text provider,
# they default to none. Configure only the services you actually want to use.
# ASR_PROVIDER=openai-compatible
# ASR_BASE_URL=https://api.openai.com/v1
# ASR_MODEL=whisper-1
# ASR_API_KEY=
# TTS_PROVIDER=openai-compatible
# TTS_BASE_URL=https://api.openai.com/v1
# TTS_MODEL=gpt-4o-mini-tts
# TTS_VOICE=alloy
# TTS_API_KEY=
# SEARCH_PROVIDER=none
