[Unit]
Description=Xiaoxi sandboxed task browser (NVMe only)
After=network-online.target
RequiresMountsFor=/mnt/nvme
ConditionPathIsMountPoint=/mnt/nvme

[Service]
Type=simple
User=deskpet-browser
Group=deskpet-browser
WorkingDirectory=/mnt/nvme/deskpet-browser
Environment=HOME=/mnt/nvme/deskpet-browser
Environment=XDG_CACHE_HOME=/mnt/nvme/deskpet-browser/cache
Environment=TMPDIR=/mnt/nvme/deskpet-browser/tmp
ExecStartPre=/usr/bin/mountpoint -q /mnt/nvme
ExecStart=/usr/bin/python3 /opt/deskpet-browser/browser_daemon.py
StandardOutput=append:/mnt/nvme/deskpet-browser/browser.log
StandardError=append:/mnt/nvme/deskpet-browser/browser.log
UMask=0077
KillMode=control-group
TimeoutStopSec=12
MemoryMax=1536M
TasksMax=128
Restart=no
